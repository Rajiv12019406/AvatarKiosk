# Required for AI conversations. Keep this secret on the backend only.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-6-luna

# Optional: ElevenLabs neural TTS with character-level timestamps.
# Find your API key in the ElevenLabs account settings and choose a voice ID from your voice library.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
